# =========================================================================
# Metered TURN Server Configuration
# =========================================================================
# For maximum security, use standard names (without VITE_) so Vercel keeps them
# strictly on the server backend (accessed only by api/turn.js):
#
# Get Username & Password from https://dashboard.metered.ca -> TURN Server -> Add Credential
METERED_USERNAME=
METERED_CREDENTIAL=

# Optional: If you prefer using Metered Domain + API Key instead:
METERED_DOMAIN=
METERED_SECRET_KEY=

# (Note: VITE_ prefixed variables are also supported as a fallback for local testing)
VITE_METERED_USERNAME=
VITE_METERED_CREDENTIAL=
